! TorchANI-Amber test input
&cntrl
    {% if mlmm %}
    ifmlmm = 1  ! Use ML/MM
    {% else %}
    imlip = 1  ! Use the MLIP Interface
    {% endif %}
    imin = 0  ! Dynamics
    nstlim = 5  ! Total num of dynamics steps
    ntx = 1  ! Only read input coords, not vels
    {% if netcdf %}
    ntxo = 2  ! Dump restart as netCDF
    ioutfm = 1  ! Dump traj as netCDF
    {% else %}
    ntxo = 1  ! Dump restart as ASCII
    ioutfm = 0  ! Dump traj as ASCII
    {% endif %}
    ntwx = 1  ! Dump coords every step
    ntpr = 1  ! Dump mdout 'logs' every step
    dt = 0.001  ! Timestep (ns)
    {% if shake %}
    ntc = 2  ! Shake ON
    ntf = 2  ! Shake ON
    {% else %}
    ntc = 1  ! Shake OFF
    ntf = 1  ! Shake OFF
    {% endif %}
    ig = 5541  ! Manual seed for reproducibility
    {% if vacuum %}
    cut = 9999.0  ! Non-bonded neighborlist cutoff
    igb = 6  ! Vacuum, no PBC
    {% else %}
    cut = 8.0  !  Non-bonded neighborlist cutoff
    {% endif %}
/
{% if mlmm %}
&mlmm
    ml_mask = ":1"  ! Select the first molecule as the ML region
    mm_cutoff = 8.0  ! 15.0 is recommended, 8.0 used for tests
{% else %}
&mlip
{% endif %}
{% if cuda %}
    cuda_device_index = 0
    use_cuda_device = .True.
    use_cuaev = .{{ cuda.cuaev }}.
{% else %}
    use_cuda_device = .False.
{% endif %}
    model_type = "animbis"  ! ANI-mbis can be used for all kinds of dynamics
    use_double_precision = .{{ float64 }}.
{% if mlmm %}
    {% if mlmm.protocol == "me" %}
    use_mlip_atomic_charges = .False.
    mlmm_coupling = 'coulombic'  ! Coulombic coupling
    {% else %}
    use_mlip_atomic_charges = .True.
    mlmm_coupling = 'simple-polarizable'  ! Simple polarizable coupling
    write_atomic_charges = .True.  ! Only predicted charges are written
    {% endif %}
    write_forces = .True.
    write_coords = .True.
{% endif %}
    model_index = -1
    use_external_neighborlist = .{{ use_amber_neighborlist }}.
/
! End TorchANI-Amber test input
