! TorchANI-Amber test input (Full-ML, Amber-NB configuration)
&cntrl
    imin = 0  ! Dynamics
    nstlim = 2000  ! Total num of dynamics steps (2 ps)
    ntx = 1  ! Only read input coords, not vels
    ntxo = 2  ! Dump restart as NetCDF 3
    ioutfm = 1  ! Dump traj as NetCDF 3
    ntwx = 1  ! Dump coords every step
    ntpr = 1  ! Dump mdout 'logs' every step
    dt = 0.001  ! Timestep (ps)
    ntc = 1  ! Shake OFF
    ntf = 1  ! Shake OFF
    ig = 5541  ! Manual seed for reproducibility
    cut = 10.0  ! Cutoff for the inter-molecular FF non-bonded interactions
    imlip = 1  ! Use the MLIP Interface
/
&mlip
    cuda_device_index = 0
    use_cuda_device = .True.
    use_cuaev = .False.
    model_type = "nutmeg-small"
    ! Gasteiger charges of all the atoms, relative to the current working directory
    extra_features_file_path = "ala-dipep-bulk.charges"
    use_external_nonbond = .True.  ! Run in Amber-NB configuration since Nutmeg is very memory hungry
    use_double_precision = .False.
    model_index = -1
    use_external_neighborlist = .False.
/
! End TorchANI-Amber test input
