#!/bin/bash

usage() { echo "Usage: [OPTION]...
    Configure, Generate buildsystem, build, run tests, and install TorchANI MLIP Interface.

    All options are boolean flags, except -j.
    -j N Build and run tests with N parallel jobs (default: CMAKE_BUILD_PARALLEL_LEVEL and
         CTEST_PARALLEL_LEVEL if set, otherwise the number of processors, at most 8)
    -B Don't build or install, only configure and generate
    -I Don't install, only configure, generate and build
    -T Don't run tests after build / installation
    -P Don't auto detect and link to PyTorch, download and install LibTorch instead
    -N Don't use Conda libraries
    -c Build CPU-only (requires a CPU-only PyTorch or LibTorch)
    -x Support Python models, run by an embedded Python interpreter (requires PyTorch,
       incompatible with -P)
    -a Build for the CUDA archs in the TORCH_CUDA_ARCH_LIST env var (e.g.
       TORCH_CUDA_ARCH_LIST=\"8.9;10.0\"), instead of auto detecting them
    -g Build in Debug configuration
    -h Print this message

    CUDA archs are auto detected by default (the GPUs of this machine). Conda envs with
    cuda-nvcc set TORCH_CUDA_ARCH_LIST on activation, it is only used with -a" 1>&2; }

use_conda_libs=ON
build_cuda=ON
use_libtorch=OFF
use_pytorch_libs=ON
run_tests=1
cmake_build=1
cmake_install=1
use_env_cuda_archs=0
support_python_models=OFF
cmake_build_type="Release"
prefix="$HOME/.local/"
parallel_jobs=""
while getopts "TIBPNcaxghj:" o; do
    case "${o}" in
        j)
            parallel_jobs="$OPTARG"
            ;;
        P)
            use_pytorch_libs=OFF
            use_libtorch=ON
            ;;
        N)
            use_conda_libs=OFF
            ;;
        c)
            build_cuda=OFF
            ;;
        a)
            use_env_cuda_archs=1
            ;;
        x)
            support_python_models=ON
            ;;
        T)
            run_tests=0
            ;;
        I)
            cmake_install=0
            ;;
        B)
            cmake_build=0
            cmake_install=0
            run_tests=0
            ;;
        g)
            cmake_build_type="Debug"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            echo "$o"
            echo "Incorrect argument"
            usage
            exit 1
            ;;
    esac
done

if [ -z "$parallel_jobs" ] && [ -z "$CMAKE_BUILD_PARALLEL_LEVEL" ] \
    && [ -z "$CTEST_PARALLEL_LEVEL" ]; then
    num_processors=$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 1)
    parallel_jobs=$((num_processors < 8 ? num_processors : 8))
fi

# An empty list makes PyTorch auto detect the archs
torch_cuda_archs=""
if [ "$use_env_cuda_archs" -eq 1 ]; then
    if [ -z "$TORCH_CUDA_ARCH_LIST" ]; then
        echo "-a requires the TORCH_CUDA_ARCH_LIST env var to be set" 1>&2
        exit 1
    fi
    torch_cuda_archs="$TORCH_CUDA_ARCH_LIST"
fi

# The directory of this script, taken from:
# https://stackoverflow.com/questions/59895/
# how-do-i-get-the-directory-where-a-bash-script-is-located-from-within-the-script
src_dir=$( cd -- "$(dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)
bld_dir="$src_dir/build"

if [ "$use_conda_libs" = "ON" ] && [ -n "$CONDA_PREFIX" ]; then
    export CFLAGS="$CFLAGS -isystem $CONDA_PREFIX/include"
    export CXXFLAGS="$CXXFLAGS -isystem $CONDA_PREFIX/include"
    export FFLAGS="$FFLAGS -isystem $CONDA_PREFIX/include"
fi

# Paths to conda compilers are automatically detected by CMake
cmake \
    -S"$src_dir" \
    -B"$bld_dir" \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_BUILD_TYPE="$cmake_build_type" \
    -DTORCHANI_BUILD_CUDA=$build_cuda \
    -DTORCHANI_SUPPORT_PYTHON_MODELS=$support_python_models \
    -DTORCHANI_LINK_TO_PYTORCH_LIBS=$use_pytorch_libs \
    -DTORCHANI_JIT_COMPILE_MODELS=$use_pytorch_libs \
    -DTORCHANI_PREFER_CONDA_LIBS=$use_conda_libs \
    -DTORCHANI_DOWNLOAD_AND_INSTALL_LIBTORCH=$use_libtorch \
    -DTORCH_CUDA_ARCH_LIST="$torch_cuda_archs" \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
CFG_EXITCODE=$?
if [ $CFG_EXITCODE -ne 0 ]; then
    echo "Configuration failed!!"
    exit 1
fi

if [ "$cmake_build" -eq 0 ]; then
    echo "Skipping build (and install) step"
    exit 0
fi

if ! cmake --build "$bld_dir" ${parallel_jobs:+-j "$parallel_jobs"}; then
    echo "Build failed!!"
    exit 1
fi

if [ "$run_tests" -eq 1 ]; then
    echo "Starting to run tests ..."
    if [ "$build_cuda" = "OFF" ]; then
        export TORCHANI_SKIP_CUDA_TESTS=1
    fi
    if ! ctest --test-dir "$bld_dir" --output-on-failure ${parallel_jobs:+-j "$parallel_jobs"}; then
        echo "Tests failed!! Skipping install step"
        exit 1
    fi
else
    echo "Skipping test step"
fi

if [ "$cmake_install" -eq 0 ]; then
    echo "Skipping install step"
    exit 0
fi

if ! cmake --install "$bld_dir"; then
    echo "Install failed!!"
    exit 1
fi
