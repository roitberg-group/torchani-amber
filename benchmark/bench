#!/usr/bin/env python
from enum import Enum
import numpy as np
from typer import Argument
import matplotlib.pyplot as plt
import time
import json
from dataclasses import dataclass, asdict
import os
import subprocess
import shutil
from pathlib import Path
import re
import socket
import sys
import typing as tp
from uuid import uuid4
import typing_extensions as tpx

from typer import Option, Typer, Abort
import jinja2
from tqdm import tqdm
from rich.console import Console

from utils import send_to_scheduler, SUPPORTED_MODELS


console = Console()
app = Typer(name="bench", pretty_exceptions_enable=False)


class BenchKind(Enum):
    SCALING = "scaling"
    REMD = "remd"


@dataclass
class ScalingConfig:
    cuaev: bool
    cuda: bool
    cutoff: float
    tstep_num: int
    model: str
    shake: bool
    dump_traj: bool
    use_all_amber_nonbond: bool
    use_amber_neighborlist: bool

    def to_json_file(self, path: Path) -> None:
        path.write_text(json.dumps(asdict(self), indent=4))


@app.command()
def run(
    hpg: tpx.Annotated[
        tp.Optional[bool],
        Option("--hpg/--no-hpg"),
    ] = None,
    gpu: tpx.Annotated[str, Option("--gpu")] = "",
    dump_traj: tpx.Annotated[
        bool,
        Option("--dump-traj/--no-dump-traj"),
    ] = False,
    shake: tpx.Annotated[
        bool,
        Option("--shake/--no-shake"),
    ] = False,
    systems: tpx.Annotated[
        tp.Optional[tp.List[str]],
        Option(
            "-s",
            "--system",
            show_default=False,
            help="Name of system(s) to run on, must be found on benchmark/system",
        ),
    ] = None,
    cuaev: tpx.Annotated[
        tp.Optional[bool],
        Option("--cuaev/--no-cuaev", help="Benchmark cuaev"),
    ] = None,
    model: tpx.Annotated[
        str,
        Option("-m", "--model"),
    ] = "ani2xr",
    cutoff: tpx.Annotated[
        tp.Optional[float],
        Option("--cutoff"),
    ] = None,
    cuda: tpx.Annotated[
        tp.Optional[bool],
        Option("--cuda/--no-cuda", help="Benchmark on CUDA device"),
    ] = None,
    # At least 200 are needed
    tstep_num: tpx.Annotated[
        int,
        Option(
            "--tsteps",
            help="Number of timesteps to run benchmarks for",
        ),
    ] = 1000,
    time_ps: tpx.Annotated[
        tp.Optional[float],
        Option("-t", "--time-ps"),
    ] = None,
    debug: tpx.Annotated[
        bool,
        Option("-g/-G", "--debug/--no-debug"),
    ] = False,
    install_kind: tpx.Annotated[
        str,
        Option("--install-kind"),
    ] = "local",
    hours: tpx.Annotated[
        int,
        Option("--hours"),
    ] = 1,
    name: tpx.Annotated[
        str,
        Option("-n", "--name"),
    ] = "",
    out_root: tpx.Annotated[
        tp.Optional[Path],
        Option("--out-root", show_default=False),
    ] = None,
    sander: tpx.Annotated[
        bool,
        Option("--no-pmemd/--pmemd", "--sander/--no-sander"),
    ] = True,
    use_amber_neighborlist: tpx.Annotated[
        bool,
        Option("--amber-neighborlist/--no-amber-neighborlist"),
    ] = False,
    use_all_amber_nonbond: tpx.Annotated[
        bool,
        Option("--amber-nonbond/--no-amber-nonbond"),
    ] = False,
    bench_kind: tpx.Annotated[
        tp.Optional[BenchKind],
        Option("-b", "--bench-kind"),
    ] = None,
    systems_src_dir: tpx.Annotated[
        tp.Optional[Path],
        Option("--systems-src-dir", show_default=False),
    ] = None,
    suffix: tpx.Annotated[
        str,
        Option("--suffix"),
    ] = "",
) -> None:
    r"""Run Pmemd or Sander benchmarks
    Important options: --bench-kind, --model, --tstep-num, --name
    Specify systems to run benchmark with -s <system> -s <system> etc
    """
    unique_id = str(uuid4()).split("-")[-1]
    if model not in SUPPORTED_MODELS:
        console.print(f"Model {model} is not supported", style="red")
        raise Abort()
    if bench_kind is None:
        bench_kind = BenchKind.SCALING
    env = jinja2.Environment(
        loader=jinja2.FileSystemLoader(Path(__file__).parent / "templates/"),
        undefined=jinja2.StrictUndefined,
        autoescape=jinja2.select_autoescape(),
        trim_blocks=True,
        lstrip_blocks=True,
    )

    if systems is None:
        if bench_kind is BenchKind.SCALING:
            if systems_src_dir is None:
                systems_src_dir = Path(
                    Path.home(), "Repos", "paper-aniamber", "waterboxes"
                )
            # Amber neighborlist seems to be slightly slower and use more GPU
            # Nothing can be handled with nutmeg-small, not even 1k
            systems = [
                "water-1k",
                "water-2_5k",
                "water-3k",
                "water-4k",
                "water-5k",
                "water-6k",
                "water-7k",
                "water-8k",  # L4 can handle this with aimnet2-dsf (explodes few tsteps)
                "water-9k",
                "water-10k",
                "water-15k",
                "water-20k",
                "water-25k",
                "water-30k",  # With amber nonbond, aimnet can handle this
                "water-45k",
                "water-60k",
                "water-75k",  # L4 can handle this with ani2dr
                "water-100k",
                "water-125k",
                "water-150k",  # L4 can handle up to this (at least) with ani2xr
                "water-175k",
                "water-200k",
            ]
            template = env.get_template("scaling.mdin.jinja")
        elif bench_kind is BenchKind.REMD:
            raise NotImplementedError("Not implemented yet")
    assert systems_src_dir is not None
    assert systems is not None

    for s in systems:
        if (
            not (systems_src_dir / f"{s}.prmtop").is_file()
            or not (systems_src_dir / f"{s}.inpcrd").is_file()
        ):
            console.print(f"System {s} inpcrd or prmtop files not found", style="red")
            raise Abort()
    if debug:
        tstep_num = 3
    if not hpg:
        if install_kind != "local" or gpu:
            console.print("--install-kind, --gpu requires --hpg", style="red")
            raise Abort()
    if not name:
        name = f"{model}-{bench_kind.value}"
    if suffix:
        name = f"{name}-{suffix}"
    if hpg is None:
        hpg = re.match(r"login\d*\.ufhpc", socket.gethostname()) is not None
    if hpg:
        send_to_scheduler(
            "hpg",
            gpu,
            name,
            hours,
            unique_id,
            core_num=1,
            install_kind=install_kind,
            env=env,
        )
        sys.exit(0)

    if cuaev is None:
        cuaev = "ani" in model
    if cutoff is None:
        if model == "ani2dr":
            cutoff = 8.0
        elif model.startswith("nutmeg") or model.startswith("aimnet"):
            cutoff = 10.0
        else:
            cutoff = 5.2

    if cuda is None:
        import torch

        cuda = torch.cuda.is_available()

    if out_root is None:
        out_root = Path(Path.home(), "IO", "ani-amber")
        out_root.mkdir(exist_ok=True, parents=True)

    out_dir = out_root / f"{unique_id}-{name}"
    out_dir.mkdir(exist_ok=True)

    if time_ps is not None:
        tstep_num = max(int(round(time_ps * (2000 if shake else 1000))), 1)

    config = ScalingConfig(
        cuaev=cuaev,
        cuda=cuda,
        dump_traj=dump_traj,
        shake=shake,
        use_all_amber_nonbond=use_all_amber_nonbond,
        use_amber_neighborlist=use_amber_neighborlist,
        cutoff=cutoff,
        model=model,
        tstep_num=tstep_num,
    )
    cmd = "sander" if sander else "pmemd"

    # This requires a version of amber that is hooked with this function
    os.environ["TORCHANI_AMBER_WALLTIME"] = "1"
    console.print(f"Output will be written to {out_dir}")
    pbar = tqdm(total=len(systems), leave=False, position=0)
    for i, system in enumerate(systems):
        if model.startswith("nutmeg"):
            config.model = f"{model}::{(systems_src_dir / system).with_suffix('.charges')}"
        pbar.set_description(f"Running system {system}, {i + 1}/{len(systems)}")
        _start = time.perf_counter()
        system_dir = out_dir / system
        system_dir.mkdir()

        (system_dir / "mdin").write_text(template.render(**asdict(config)))
        config.to_json_file(system_dir / "config.json")
        shutil.copy(systems_src_dir / f"{system}.inpcrd", system_dir / "inpcrd")
        shutil.copy(systems_src_dir / f"{system}.prmtop", system_dir / "prmtop")
        pbar.update()
        out = subprocess.run(
            cmd, cwd=system_dir, check=False, text=True, capture_output=True
        )
        if out.returncode != 0:
            console.print(f"System {i + 1} failed")
            console.print(f"stdout: {out.stdout}")
            console.print(f"stderr: {out.stderr}")
            break
        console.print(
            f"Done with system {i + 1}, time {time.perf_counter() - _start:.4f} s"
        )


@app.command()
def plot(
    names_or_paths: tpx.Annotated[list[str], Argument()],
    burn_in_tstep_num: tpx.Annotated[
        int,
        Option("-b", "--burn-in-tstep-num"),
    ] = 100,
    labels: tpx.Annotated[
        tp.Optional[list[str]],
        Option("-l", "--label"),
    ] = None,
    out_root: tpx.Annotated[
        tp.Optional[Path],
        Option("--out-root", show_default=False),
    ] = None,
) -> None:
    # pass names, automatically plots things in ~/IO/ani-amber
    if labels is None:
        labels = []
        for n in names_or_paths:
            fname = Path(n).name if Path(n).is_dir() else n
            label = "-".join(fname.split("-")[1:-1])
            label = label.replace("aimnet2-wb97m-dsf", "AimNet2").replace("ani", "ANI-")
            labels.append(label)
    if out_root is None:
        out_root = Path(Path.home(), "IO", "ani-amber")
    possible_paths = sorted(out_root.iterdir())
    fig, ax = plt.subplots()
    for n, label in zip(names_or_paths, labels):
        _plot_single(ax, n, possible_paths, burn_in_tstep_num, label)
    ax.set_xlabel("Num. atoms")
    ax.set_ylabel("Time per timestep (ms)")
    ax.legend()
    plt.show()


def _plot_single(
    ax: plt.Axes,
    name: str,
    paths: list[Path],
    burn_in_tstep_num: int = 0,
    label: str = "",
) -> None:
    if Path(name).is_dir():
        fpath = Path(name)
    else:
        paths = [p for p in paths if re.match(f".*{name}", p.name)]
        if not paths:
            console.print("Found no matching paths", style="red")
            raise Abort()
        if len(paths) > 1:
            console.print(
                f"Found more than one possible matching paths {list(map(str, paths))}",
                style="red",
            )
            raise Abort()
        fpath = paths[0]
    _atoms_num = []
    _means = []
    _stds = []
    for d in fpath.iterdir():
        inpcrd_fpath = Path(d, "inpcrd")
        walltimes_path = Path(d, "walltime_ms.dat")
        if not walltimes_path.is_file():
            continue
        with open(inpcrd_fpath, mode="rt", encoding="utf-8") as f:
            for i, line in enumerate(f):
                if i == 1:
                    _atoms_num.append(int(line))
                    break
        walltimes_ms = list(map(float, walltimes_path.read_text().split()))
        walltimes_ms = walltimes_ms[burn_in_tstep_num:]
        walltimes_ms_arr = np.array(walltimes_ms)
        _means.append(np.mean(walltimes_ms_arr))
        _stds.append(np.std(walltimes_ms_arr))
    atoms_num = np.array(_atoms_num)
    means = np.array(_means)
    stds = np.array(_stds)
    sort_idxs = np.argsort(atoms_num)
    atoms_num = atoms_num[sort_idxs]
    means = means[sort_idxs]
    stds = stds[sort_idxs]
    ax.errorbar(atoms_num, means, yerr=stds, capsize=1.0, marker="s", ms=3, label=label)


if __name__ == "__main__":
    app()
